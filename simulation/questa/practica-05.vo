`timescale 1 ps/ 1 ps

module practica5 (
	pto0,
	pto1,
	sel,
	ptops);
input 	pto0;
input 	pto1;
input 	sel;
output 	ptops;

// Design Ports Information
// ptops	=>  Location: PIN_L1,	 I/O Standard: 2.5 V,	 Current Strength: Default
// pto1	=>  Location: PIN_K1,	 I/O Standard: 2.5 V,	 Current Strength: Default
// pto0	=>  Location: PIN_K2,	 I/O Standard: 2.5 V,	 Current Strength: Default
// sel	=>  Location: PIN_J2,	 I/O Standard: 2.5 V,	 Current Strength: Default


wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
wire \ptops~output_o ;
wire \pto1~input_o ;
wire \pto0~input_o ;
wire \sel~input_o ;
wire \ptops~0_combout ;


hard_block auto_generated_inst(
	.devpor(devpor),
	.devclrn(devclrn),
	.devoe(devoe));

// Location: IOOBUF_X0_Y11_N9
cycloneive_io_obuf \ptops~output (
	.i(\ptops~0_combout ),
	.oe(vcc),
	.seriesterminationcontrol(16'b0000000000000000),
	.devoe(devoe),
	.o(\ptops~output_o ),
	.obar());
// synopsys translate_off
defparam \ptops~output .bus_hold = "false";
defparam \ptops~output .open_drain_output = "false";
// synopsys translate_on

// Location: IOIBUF_X0_Y12_N8
cycloneive_io_ibuf \pto1~input (
	.i(pto1),
	.ibar(gnd),
	.o(\pto1~input_o ));
// synopsys translate_off
defparam \pto1~input .bus_hold = "false";
defparam \pto1~input .simulate_z_as = "z";
// synopsys translate_on

// Location: IOIBUF_X0_Y12_N1
cycloneive_io_ibuf \pto0~input (
	.i(pto0),
	.ibar(gnd),
	.o(\pto0~input_o ));
// synopsys translate_off
defparam \pto0~input .bus_hold = "false";
defparam \pto0~input .simulate_z_as = "z";
// synopsys translate_on

// Location: IOIBUF_X0_Y15_N1
cycloneive_io_ibuf \sel~input (
	.i(sel),
	.ibar(gnd),
	.o(\sel~input_o ));
// synopsys translate_off
defparam \sel~input .bus_hold = "false";
defparam \sel~input .simulate_z_as = "z";
// synopsys translate_on

// Location: LCCOMB_X1_Y15_N16
cycloneive_lcell_comb \ptops~0 (
// Equation(s):
// \ptops~0_combout  = (\sel~input_o  & (\pto1~input_o )) # (!\sel~input_o  & ((\pto0~input_o )))

	.dataa(gnd),
	.datab(\pto1~input_o ),
	.datac(\pto0~input_o ),
	.datad(\sel~input_o ),
	.cin(gnd),
	.combout(\ptops~0_combout ),
	.cout());
// synopsys translate_off
defparam \ptops~0 .lut_mask = 16'hCCF0;
defparam \ptops~0 .sum_lutc_input = "datac";
// synopsys translate_on

assign ptops = \ptops~output_o ;

endmodule

module hard_block (

	devpor,
	devclrn,
	devoe);

// Design Ports Information
// ~ALTERA_ASDO_DATA1~	=>  Location: PIN_C1,	 I/O Standard: 2.5 V,	 Current Strength: Default
// ~ALTERA_FLASH_nCE_nCSO~	=>  Location: PIN_D2,	 I/O Standard: 2.5 V,	 Current Strength: Default
// ~ALTERA_DCLK~	=>  Location: PIN_H1,	 I/O Standard: 2.5 V,	 Current Strength: Default
// ~ALTERA_DATA0~	=>  Location: PIN_H2,	 I/O Standard: 2.5 V,	 Current Strength: Default
// ~ALTERA_nCEO~	=>  Location: PIN_F16,	 I/O Standard: 2.5 V,	 Current Strength: 8mA

input 	devpor;
input 	devclrn;
input 	devoe;

wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

wire \~ALTERA_ASDO_DATA1~~padout ;
wire \~ALTERA_FLASH_nCE_nCSO~~padout ;
wire \~ALTERA_DATA0~~padout ;
wire \~ALTERA_ASDO_DATA1~~ibuf_o ;
wire \~ALTERA_FLASH_nCE_nCSO~~ibuf_o ;
wire \~ALTERA_DATA0~~ibuf_o ;


endmodule
